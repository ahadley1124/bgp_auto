#!/usr/bin/env python3
"""Check that the BIRD protocols this deploy stage depends on are up.

Reads /etc/bgp-auto/expected.json: {"protocols": ["name", ...]}.
BGP and RPKI protocols must be Established, OSPF must be Running.
Exit 0 when everything is up, 1 otherwise (prints what is missing).

  bgp-auto-health [--wait SECONDS] [--config FILE] [--show]
"""
import argparse
import json
import subprocess
import sys
import time

CONFIG = "/etc/bgp-auto/expected.json"


def protocols(birdc="birdc"):
    p = subprocess.run([birdc, "show", "protocols"], capture_output=True, text=True)
    if p.returncode != 0:
        return None, p.stdout + p.stderr
    rows = {}
    for line in p.stdout.splitlines():
        parts = line.split(None, 6)
        # Name Proto Table State Since Info   (Since is two tokens: date + time)
        if len(parts) < 5 or parts[1] not in ("BGP", "OSPF", "RPKI", "Static", "Kernel", "Device", "BFD", "Direct"):
            continue
        info = parts[6] if len(parts) > 6 else ""
        rows[parts[0]] = {"proto": parts[1], "state": parts[3], "info": info.strip()}
    return rows, p.stdout


def status(rows, names):
    bad = []
    for n in names:
        r = rows.get(n)
        if r is None:
            bad.append("%s: not configured" % n)
        elif r["state"] != "up":
            bad.append("%s: %s %s" % (n, r["state"], r["info"]))
        elif r["proto"] in ("BGP", "RPKI") and r["info"] != "Established":
            bad.append("%s: %s" % (n, r["info"] or "not established"))
        elif r["proto"] == "OSPF" and r["info"] not in ("Running", ""):
            bad.append("%s: %s" % (n, r["info"]))
    return bad


def main(argv=None):
    ap = argparse.ArgumentParser()
    ap.add_argument("--config", default=CONFIG)
    ap.add_argument("--wait", type=int, default=0)
    ap.add_argument("--show", action="store_true")
    ap.add_argument("--birdc", default="birdc")
    a = ap.parse_args(argv)
    names = json.load(open(a.config))["protocols"]
    deadline = time.time() + a.wait
    while True:
        rows, raw = protocols(a.birdc)
        bad = ["birdc failed: %s" % raw.strip()] if rows is None else status(rows, names)
        if not bad:
            print("OK: %d protocol(s) up" % len(names))
            if a.show and rows:
                print(raw)
            return 0
        if time.time() >= deadline:
            print("NOT READY:\n  " + "\n  ".join(bad))
            return 1
        time.sleep(5)


if __name__ == "__main__":
    sys.exit(main())
