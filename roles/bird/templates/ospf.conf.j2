# =====================================
# AUTO-GENERATED OSPF UNDERLAY
# =====================================

protocol ospf v2 ospf_underlay {
    ipv4 {
        table master4;
        import all;
        export filter {
            if source = RTS_DEVICE && (ifname ~ "gre" || ifname = "local" || ifname = "lo") then accept;
            reject;
        };
    };

    area 0 {
        interface "*gre*" {
            type pointopoint;
            hello 1;
            dead 10;
        };
    };
}
